# Local-first default
OLLAMA_BASE_URL=http://ollama:11434
# qwen3:8b is the practical Codespaces baseline; use qwen3-coder on larger machines.
WORK_OLLAMA_CODING_MODEL=qwen3:8b
WORK_OLLAMA_REASONING_MODEL=qwen3:8b
WORK_OLLAMA_FAST_MODEL=qwen3:4b
WORK_OLLAMA_GENERAL_MODEL=qwen3:8b
WORK_INSTALL_FAST_MODEL=false

# Optional providers. Leave blank until the team has credentials or an eligible free tier.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=
